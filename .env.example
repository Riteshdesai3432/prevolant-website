# Copy to .env for local use (never commit .env). On a host, set these in its environment settings.
# Generate the four secret values with:  npm run gen:secrets

NODE_ENV=production
PORT=3000
# Public https address of the site (no trailing slash). Required in production.
SITE_URL=https://www.your-domain.com

# Secret admin location (24+ random characters). Never link to it. Changing it moves the admin URL.
ADMIN_PATH=
# 32+ random characters. Used to sign/hash session-related values.
SESSION_SECRET=
# Field-encryption keys: "version:base64(32 bytes)", comma separated. Keep old versions so old data stays readable.
DATA_ENCRYPTION_KEYS=
DATA_KEY_CURRENT=1

# Storage (use a persistent disk/volume in production)
DB_PATH=/var/data/prevolant.db
UPLOAD_DIR=/var/data/uploads

# Number of reverse proxies in front of the app (Render/Vercel/Cloudflare = 1)
TRUST_PROXY=1
# Optional: only allow the admin area from these IPs (comma separated)
ADMIN_IP_ALLOWLIST=
# Delete enquiries older than N months (0 = keep forever)
RETENTION_MONTHS=12

# Email (optional but recommended). Without SMTP no emails are sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Prevolant <no-reply@your-domain.com>"
NOTIFY_TO=Prevolant04@gmail.com

# Cloudflare Turnstile bot protection for the contact form (optional but recommended)
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
